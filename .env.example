# 运行 uv run takeaway init 自动创建 .env 与随机密码；不要把 .env 加入 Git。
TAKEAWAY_DATABASE_URL=sqlite:///./data/takeaway.db
TAKEAWAY_ADMIN_USERNAME=admin
TAKEAWAY_ADMIN_PASSWORD=
TAKEAWAY_SECRET_KEY=
TAKEAWAY_MCP_TOKEN=
TAKEAWAY_PUBLIC_URL=http://127.0.0.1:8765
TAKEAWAY_SECURE_COOKIES=false

# 网页仅填写变量名称；每店独立授权。不使用其他门店配置兜底。
ELM_SHOP1_APP_KEY=
ELM_SHOP1_APP_SECRET=
ELM_SHOP1_ACCESS_TOKEN=
JD_SHOP1_APP_KEY=
JD_SHOP1_APP_SECRET=
JD_SHOP1_ACCESS_TOKEN=

# Docker Compose 使用；在第一次启动前填入随机数据库密码
POSTGRES_PASSWORD=
