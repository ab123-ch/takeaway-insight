[Unit]
Description=餐账本地Agent定时任务
After=network-online.target takeaway-web.service
Wants=network-online.target

[Service]
Type=simple
User=takeaway
WorkingDirectory=/opt/takeaway-insight
EnvironmentFile=/opt/takeaway-insight/.env
ExecStart=/opt/takeaway-insight/.venv/bin/takeaway worker
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
